<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>MKV Batch Processor</Title>
    <Description>Batch convert MKV files to MP4 with hardware acceleration and audio normalization</Description>
    <Company>Personal</Company>
    <Product>MKV Batch Processor</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ffmpeg\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="pgstosrt\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
