<Window x:Class="MkvProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MkvProcessor.Converters"
        xmlns:models="clr-namespace:MkvProcessor.Models"
        xmlns:vm="clr-namespace:MkvProcessor.ViewModels"
        xmlns:views="clr-namespace:MkvProcessor.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MKV Batch Processor"
        Height="700" Width="950"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToStringConverter x:Key="StatusToString"/>
        <converters:AudioModeConverter x:Key="AudioModeConverter"/>
        <converters:QualityPresetConverter x:Key="QualityPresetConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:StringCollectionToTextConverter x:Key="StringCollectionToText"/>

        <!-- Expander Toggle Button Style -->
        <Style x:Key="ExpanderToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Arrow" Text="▶" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="MKV Batch Processor"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="ShowWindow_Click"/>
                    <MenuItem Header="Pause/Resume" Click="PauseResume_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Background="#80000000" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Detecting encoders..." Foreground="White" FontSize="16"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Main TabControl -->
        <TabControl Margin="10" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">

            <!-- Processing Tab -->
            <TabItem Header="Processing">
                <Grid AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Settings Panel (Collapsible) -->
            <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ExpanderToggleButton}"
                                  IsChecked="{Binding IsSettingsExpanded}"
                                  Content="Settings" FontWeight="SemiBold"/>

                    <Grid Visibility="{Binding IsSettingsExpanded, Converter={StaticResource BoolToVis}}"
                          Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Quality -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Quality:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,20,10"
                                  ItemsSource="{Binding QualityPresets}"
                                  SelectedItem="{Binding SelectedQualityPreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource QualityPresetConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Encoder -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Encoder:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"
                                  ItemsSource="{Binding AvailableEncoders}"
                                  SelectedItem="{Binding SelectedEncoder}"
                                  DisplayMemberPath="DisplayName"/>

                        <!-- Audio Mode -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,20,10"
                                  ItemsSource="{Binding AudioModes}"
                                  SelectedItem="{Binding Settings.AudioMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AudioModeConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Output Folder -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Output:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <Grid Grid.Row="1" Grid.Column="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputFolder}" IsReadOnly="True" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0"
                                    Command="{Binding BrowseOutputFolderCommand}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- File List -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File List Header -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                        Background="#F8F8F8" Padding="10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="("/>
                            <Run Text="{Binding SelectedFilesInfo, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <Button Grid.Column="2" Content="Add Files" Padding="10,5" Margin="0,0,5,0"
                                Command="{Binding AddFilesCommand}"/>
                        <Button Grid.Column="3" Content="Add Folder" Padding="10,5" Margin="0,0,15,0"
                                Command="{Binding AddFolderCommand}"/>

                        <Button Grid.Column="4" Content="▲" Width="25" Margin="0,0,3,0" ToolTip="Move Up"
                                Command="{Binding MoveFileUpCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=FileGrid}"/>
                        <Button Grid.Column="5" Content="▼" Width="25" Margin="0,0,3,0" ToolTip="Move Down"
                                Command="{Binding MoveFileDownCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=FileGrid}"/>
                        <Button Grid.Column="6" Content="Remove" Margin="0,0,3,0" Padding="8,5"
                                Command="{Binding RemoveSelectedFileCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=FileGrid}"/>
                        <Button Grid.Column="7" Content="Clear Done" Padding="8,5"
                                Command="{Binding ClearCompletedCommand}"/>
                    </Grid>
                </Border>

                <!-- File DataGrid -->
                <DataGrid x:Name="FileGrid" Grid.Row="1"
                          ItemsSource="{Binding Files}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationFormatted}" Width="70" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToString}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Progress" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="15"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Progress Section -->
            <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
                    Padding="10" Margin="0,10,0,10"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>
                            <Run Text="Current: "/>
                            <Run Text="{Binding CurrentFileName}" FontWeight="SemiBold"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding CurrentStep}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentFileProgress, StringFormat={}{0:F0}%}"/>
                    </Grid>
                    <ProgressBar Value="{Binding CurrentFileProgress}" Minimum="0" Maximum="100" Height="20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overall Progress:"/>
                        <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat={}{0:F0}%}"/>
                    </Grid>
                    <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="100" Height="15" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Log Panel (Collapsible) -->
            <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
                    Margin="0,0,0,10" MaxHeight="150">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ExpanderToggleButton}"
                                  IsChecked="{Binding IsLogExpanded}"
                                  Content="Log Output"/>

                    <TextBox Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                             Height="120"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Margin="5"
                             x:Name="LogTextBox"/>
                </StackPanel>
            </Border>

            <!-- Control Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Start Processing" Padding="20,10" FontWeight="Bold"
                        Background="#0078D4" Foreground="White"
                        Command="{Binding StartProcessingCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                <Button Grid.Column="1" Content="Pause" Padding="20,10"
                        Command="{Binding PauseProcessingCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" Content="Resume" Padding="20,10" Margin="10,0"
                        Command="{Binding ResumeProcessingCommand}"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="3" Content="Cancel" Padding="20,10"
                        Command="{Binding CancelProcessingCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="Gray"/>
            </Grid>
                </Grid>
            </TabItem>

            <!-- TV Renaming Tab -->
            <TabItem Header="TV Renaming">
                <views:TvRenamerView x:Name="TvRenamerView" Margin="0,10,0,0"/>
            </TabItem>

            <!-- Subtitle Converter Tab -->
            <TabItem Header="Subtitle Converter">
                <views:SubtitleConverterView x:Name="SubtitleConverterView" Margin="0,10,0,0"/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
